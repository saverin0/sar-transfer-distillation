# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Use short-lived, least-privilege tokens, and keep this file private.

# huggingface.co -> Settings -> Access Tokens. A read token is enough. It is needed
# for the gated DINOv3 weights. Major-TOM, TerraFM, SigLIP2 and PE-Spatial are public.
HF_TOKEN=
# Optional. A write token, needed only by the upload cell of notebook 01 (the pilot data to its
# private repo). When present, the scoring notebooks also use it to read the private dataset copies.
# Add it for that cell and remove it afterwards.
HF_WRITE_TOKEN=

# The private Hugging Face dataset repo that holds the pilot data, the full owner/name.
DATA_HF_REPO=
# The folder under MyDrive that holds pilot/ and stage0/ of the data, without the MyDrive prefix.
DATA_DRIVE_DIR=
# The Hugging Face owner of the private copies of the four SAR datasets (optional, else Drive copies).
DATASET_HF_OWNER=
# The folder under MyDrive that holds part two's results/, without the MyDrive prefix.
REFERENCE_DRIVE_DIR=
# The folder under MyDrive of the model weights shared by every project (HF_HOME), without the MyDrive prefix.
MODEL_CACHE_DRIVE_DIR=
